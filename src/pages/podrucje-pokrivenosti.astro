---
import BaseLayout from '../layouts/BaseLayout.astro';
import Eyebrow from '../components/primitives/Eyebrow.astro';
import Button from '../components/primitives/Button.astro';
import Coverage from '../components/islands/Coverage.astro';
import CalculatorWizard from '../components/islands/CalculatorWizard.astro';
import FaqList from '../components/sections/FaqList.astro';
import { TOWNS } from '../data/towns';
import { localBusinessJsonLd } from '../lib/jsonld';
---
<BaseLayout
  title="Područje pokrivenosti — Nema Fleka | Dubinsko čišćenje od Dugog Sela do Koprivnice"
  description="Gdje dolazimo: Vrbovec, Dugo Selo, Ivanić-Grad, Križevci, Bjelovar, Koprivnica i okolica. Besplatan dolazak u zoni oko Vrbovca, dalje uz mali putni dodatak."
  path="/podrucje-pokrivenosti"
  jsonLd={[localBusinessJsonLd()]}
>
  <section class="section hub-head">
    <div class="container">
      <Eyebrow>Baza: Vrbovec</Eyebrow>
      <h1 class="section-h2">Područje koje pokrivamo</h1>
      <p class="section-sub left">
        Lokalni smo tim iz Vrbovca i dolazimo k vama u cijelom koridoru od Dugog Sela do
        Koprivnice. Ispod je svako mjesto koje pokrivamo, s poštenom informacijom o dolasku.
        Ne vidite svoje mjesto? <strong>Pišite nam — vjerojatno ipak dolazimo.</strong>
      </p>
      <Button href="#kalkulator" variant="cta">Izračunajte cijenu za svoju adresu →</Button>
    </div>
  </section>

  <Coverage />

  <section class="section section-tint">
    <div class="container">
      <h2 class="section-h2">Mjesta koja pokrivamo</h2>
      <div class="town-grid">
        {TOWNS.map((t) => (
          <div class="town-card">
            <h3>{t.name}</h3>
            <p class="town-dist mono">~{t.distanceKm} km od Vrbovca</p>
            <span class:list={['town-tag', t.free ? 'town-free' : 'town-sur']}>
              {t.free ? 'Besplatan dolazak' : 'Mali putni dodatak'}
            </span>
          </div>
        ))}
      </div>
      <p class="town-note muted">Udaljenosti su okvirne. Točan dolazak i cijenu potvrđujemo pri dogovoru.</p>
    </div>
  </section>

  <CalculatorWizard />
  <FaqList />
</BaseLayout>
