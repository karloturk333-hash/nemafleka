---
import BaseLayout from '../layouts/BaseLayout.astro';
import Eyebrow from '../components/primitives/Eyebrow.astro';
import Button from '../components/primitives/Button.astro';
import Coverage from '../components/islands/Coverage.astro';
import FaqList from '../components/sections/FaqList.astro';
import { TOWNS, cityPath } from '../data/towns';
import { localBusinessJsonLd, breadcrumbJsonLd } from '../lib/jsonld';
---
<BaseLayout
  title="Područje pokrivenosti, Nema Fleka | Dubinsko čišćenje od Dugog Sela do Koprivnice"
  description="Gdje dolazimo: Vrbovec, Dugo Selo, Ivanić-Grad, Križevci, Bjelovar, Koprivnica i okolica. Besplatan dolazak u lokalnoj zoni, Bjelovar i Koprivnica +15 €."
  path="/podrucje-pokrivenosti"
  jsonLd={[
    breadcrumbJsonLd([
      { name: 'Početna', path: '/' },
      { name: 'Područje pokrivenosti', path: '/podrucje-pokrivenosti' },
    ]),
    localBusinessJsonLd(),
  ]}
>
  <section class="section hub-head">
    <div class="container">
      <Eyebrow>Baza: Vrbovec</Eyebrow>
      <h1 class="section-h2">Područje koje pokrivamo</h1>
      <p class="section-sub left">
        Lokalni smo tim iz Vrbovca i dolazimo k vama u cijelom koridoru od Dugog Sela do
        Koprivnice. Ispod je svako mjesto koje pokrivamo, s poštenom informacijom o dolasku.
        Ne vidite svoje mjesto? <strong>Pišite nam, vjerojatno ipak dolazimo.</strong>
      </p>
      <Button href="/#cjenik" variant="cta">Pogledajte cjenik →</Button>
    </div>
  </section>

  <Coverage showPlacesCta={false} />

  <section class="section section-tint">
    <div class="container">
      <h2 class="section-h2">Mjesta koja pokrivamo</h2>
      <div class="town-grid">
        {TOWNS.map((t) => (
          <a class="town-card town-card-link" href={cityPath(t.slug)}>
            <h3>{t.name}</h3>
            <p class="town-dist mono">{t.distanceKm === 0 ? 'Baza' : `~${t.distanceKm} km od Vrbovca`}</p>
            <span class:list={['town-tag', t.free ? 'town-free' : 'town-sur']}>
              {t.free ? 'Besplatan dolazak' : `+${t.travelFee} € putni trošak`}
            </span>
          </a>
        ))}
      </div>
      <p class="town-note muted">Udaljenosti su okvirne. Točan dolazak i cijenu potvrđujemo pri dogovoru.</p>
    </div>
  </section>

  <FaqList />
</BaseLayout>
