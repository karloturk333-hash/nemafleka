---
import { Image } from 'astro:assets';
import Button from '../primitives/Button.astro';
import Icon from '../primitives/Icon.astro';
import ShaderBg from '../islands/ShaderBg.astro';
import { waLink } from '../../lib/links';
import couchAfter from '../../assets/ba-couch-after.webp';
import couchBefore from '../../assets/ba-couch-before.webp';

const proofWidths = [420, 760, 1100];
const proofSizes = '(max-width: 900px) 92vw, 560px';
---
<section class="hero">
  <div class="hero-bg" aria-hidden="true"></div>
  <ShaderBg id="hero-shader" class="hero-canvas" colors={['#181A6E', '#2A2EA0', '#3D40C2', '#5A5DD6']} />
  <div class="hero-scrim" aria-hidden="true"></div>
  <div class="hero-grid">
    <div class="hero-copy">
      <span class="eyebrow">Vrbovec · Dugo Selo · Križevci · Bjelovar · Koprivnica</span>
      <h1 class="hero-h1">Fleke<br /><span class="accent">nemaju šanse.</span></h1>
      <p class="hero-sub">
        Dubinsko čišćenje kauča, tepiha, madraca i automobila, kod vas doma, brzo i temeljito.
        Lokalni tim iz Vrbovca. <strong>Cijenu znate unaprijed.</strong>
      </p>
      <div class="hero-cta-row">
        <Button href="#kalkulator" variant="cta" size="lg">Izračunaj cijenu →</Button>
        <Button href={waLink()} variant="ghost" size="lg" external><Icon name="whatsapp" size={18} /> Pišite nam</Button>
      </div>
    </div>
    <div class="hero-proof">
      <figure class="proof-frame">
        <div class="proof-split">
          <Image src={couchAfter} alt="Kauč nakon dubinskog čišćenja, čist i svjež" class="proof-after" widths={proofWidths} sizes={proofSizes} loading="eager" fetchpriority="high" />
          <Image src={couchBefore} alt="Kauč prije čišćenja, prljav i istrošen" class="proof-before" widths={proofWidths} sizes={proofSizes} loading="eager" />
          <span class="proof-divider" aria-hidden="true"></span>
          <span class="proof-tag proof-tag-before">PRIJE</span>
          <span class="proof-tag proof-tag-after">NAKON</span>
        </div>
        <figcaption class="proof-cap"><span class="mono">PRAVI REZULTAT</span> · naš rad</figcaption>
      </figure>
      <div class="proof-badge"><strong>100%</strong><span>povrat ako niste zadovoljni</span></div>
    </div>
  </div>
</section>
