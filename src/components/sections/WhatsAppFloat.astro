---
import Icon from '../primitives/Icon.astro';
import { waLink, WA_MSG } from '../../lib/links';
interface Props {
  waMessage?: string;
  waSource?: string;
}
const { waMessage = WA_MSG.sticky, waSource = 'sticky' } = Astro.props;
---
<a class="wa-float" href={waLink(waMessage)} target="_blank" rel="noopener" data-wa-source={waSource} aria-label="Pišite nam na WhatsApp">
  <Icon name="whatsapp" size={26} />
  <span>WhatsApp</span>
</a>
