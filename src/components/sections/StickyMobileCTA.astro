---
import Icon from '../primitives/Icon.astro';
import { waLink, telLink } from '../../lib/links';
---
<div class="mcta" aria-label="Brzi kontakt">
  <a href={telLink(0)} class="mcta-btn mcta-call"><Icon name="phone" size={18} /> Pozovi</a>
  <a href={waLink()} class="mcta-btn mcta-wa" target="_blank" rel="noopener"><Icon name="whatsapp" size={18} /> WhatsApp</a>
</div>
