---
import SectionHeader from '../primitives/SectionHeader.astro';
import Button from '../primitives/Button.astro';
import Icon from '../primitives/Icon.astro';
import { PRICE_GROUPS } from '../../data/services';
import { LIVING_ROOM_PACKAGE, MIN_ORDER, TRAVEL_ZONES } from '../../data/pricing';
import { waLink, WA_MSG } from '../../lib/links';

interface Props {
  waMessage?: string;
  waSource?: string;
}
const { waMessage = WA_MSG.cjenik, waSource = 'cjenik' } = Astro.props;
---
<section class="section section-tint" id="cjenik">
  <div class="container">
    <SectionHeader
      title="Transparentne cijene"
      sub="Konkretne stavke, bez 'od'. Finalna cijena nakon dogovora nikad nije viša od dogovorene."
    />
    <div class="price-card">
      {PRICE_GROUPS.map((g) => (
        <div class="price-group">
          <h3 class="price-group-title">{g.title}</h3>
          <div class="price-table">
            {g.rows.map((r) => (
              <div class:list={['price-row', r.featured && 'best']}>
                <span class="p-name">
                  {r.name}
                  {r.note && <small class="p-note">{r.note}</small>}
                </span>
                <span class="p-val mono">{r.price}</span>
              </div>
            ))}
          </div>
        </div>
      ))}

      <div class="price-package">
        <h3>Paket "Dnevni boravak" — {LIVING_ROOM_PACKAGE.price} €</h3>
        <p>{LIVING_ROOM_PACKAGE.includes}</p>
        <p class="price-was"><s>Zasebno {LIVING_ROOM_PACKAGE.wasPrice} €</s></p>
      </div>

      <div class="price-group">
        <h3 class="price-group-title">Dolazak</h3>
        <div class="price-table">
          {TRAVEL_ZONES.map((z) => (
            <div class="price-row">
              <span class="p-name">
                {z.name}
                {z.note && <small class="p-note">{z.note}</small>}
              </span>
              <span class="p-val mono">{z.price}</span>
            </div>
          ))}
        </div>
      </div>

      <p class="price-min muted">Minimalni izlazak {MIN_ORDER} €</p>

      <div class="badge-strip">
        <span class="badge">Garancija zadovoljstva</span>
        <span class="badge">Ekološki</span>
      </div>
      <Button href={waLink(waMessage)} variant="wa" class="price-cta" external data-wa-source={waSource}>
        <Icon name="whatsapp" size={18} /> Pišite nam na WhatsApp →
      </Button>
    </div>
  </div>
</section>
