---
import Button from '../primitives/Button.astro';
import MobileNav from '../islands/MobileNav.astro';
import { WA_MSG } from '../../lib/links';
interface Props {
  waMessage?: string;
  waSource?: string;
}
const { waMessage = WA_MSG.sticky, waSource = 'sticky' } = Astro.props;
const links = [
  { href: '/#usluge', label: 'Usluge' },
  { href: '/#dokaz', label: 'Rezultati' },
  { href: '/#kako', label: 'Kako radimo' },
  { href: '/#zona', label: 'Zona' },
  { href: '/#faq', label: 'FAQ' },
];
---
<header class="nav">
  <div class="nav-inner">
    <a href="/" class="nav-logo" aria-label="Nema Fleka, početna">
      <img src="/images/logo.webp" alt="Nema Fleka" width="400" height="259" />
    </a>
    <nav class="nav-links" aria-label="Glavna navigacija">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
    <Button href="/#kalkulator" variant="cta" class="nav-cta">Besplatna procjena</Button>
    <MobileNav links={links} waMessage={waMessage} waSource={waSource} />
  </div>
</header>
