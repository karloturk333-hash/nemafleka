---
import Button from '../primitives/Button.astro';
import { FAQ } from '../../data/faq';
import { waLink } from '../../lib/links';
---
<section class="section section-tint" id="faq">
  <div class="container faq-grid">
    <div class="faq-side">
      <span class="eyebrow eyebrow-dark">Česta pitanja</span>
      <h2 class="section-h2">Imate pitanje?<br />Mi imamo odgovor.</h2>
      <p class="faq-side-desc">Niste našli pitanje? Javite se, odgovaramo brzo.</p>
      <Button href={waLink('Bok! Imam pitanje o dubinskom čišćenju.')} variant="wa" external>Pitajte nas direktno →</Button>
    </div>
    <div class="faq-list">
      {FAQ.map((f, i) => (
        <details open={i === 0}>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
