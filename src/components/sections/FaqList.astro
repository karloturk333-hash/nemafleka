---
import Button from '../primitives/Button.astro';
import { FAQ, type FaqEntry } from '../../data/faq';
import { waLink, WA_MSG } from '../../lib/links';
interface Props {
  entries?: FaqEntry[];
  waMessage?: string;
  waSource?: string;
}
const { entries = FAQ, waMessage = WA_MSG.faq, waSource = 'faq' } = Astro.props;
---
<section class="section section-tint" id="faq">
  <div class="container faq-centered">
    <div class="faq-head">
      <h2 class="section-h2">Imate pitanje? Mi imamo odgovor.</h2>
      <p class="faq-side-desc">Niste našli pitanje? Javite se, odgovaramo brzo.</p>
      <Button href={waLink(waMessage)} variant="wa" external data-wa-source={waSource}>Pitajte nas direktno →</Button>
    </div>
    <div class="faq-list">
      {entries.map((f, i) => (
        <details open={i === 0}>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
