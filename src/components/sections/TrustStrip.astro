---
import Icon from '../primitives/Icon.astro';
const items = [
  { icon: 'shield', t: 'Garancija zadovoljstva', s: 'Niste zadovoljni? Dolazimo ponovno ili vraćamo novac.' },
  { icon: 'leaf', t: 'Ekološka sredstva', s: 'Sigurno za djecu, ljubimce i alergičare.' },
  { icon: 'bolt', t: 'Brz dolazak', s: 'Lokalni smo, bez čekanja tjednima.' },
  { icon: 'clock', t: 'Odgovor u 30 min', s: 'Pišete na WhatsApp, javimo se brzo.' },
] as const;
---
<section class="trust" aria-label="Zašto nam vjerovati">
  <div class="trust-inner">
    {items.map((i) => (
      <div class="trust-item">
        <span class="trust-ic"><Icon name={i.icon} size={26} /></span>
        <div><strong>{i.t}</strong><small>{i.s}</small></div>
      </div>
    ))}
  </div>
</section>
