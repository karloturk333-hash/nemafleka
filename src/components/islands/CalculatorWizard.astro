---
import SectionHeader from '../primitives/SectionHeader.astro';
import { SERVICES, SERVICE_EMOJI } from '../../data/services';
import { LIVING_ROOM_PACKAGE } from '../../data/pricing';
import { waLink } from '../../lib/links';

interface Props {
  defaultLocation?: string;
  waSource?: string;
}
const { defaultLocation = '', waSource = 'kalkulator' } = Astro.props;
const fallbackWa = waLink('Bok! Želim procjenu preko kalkulatora.');
---
<section class="section" id="kalkulator">
  <div class="container">
    <SectionHeader
      title="Izračunajte svoju cijenu"
      sub="Korak po korak: odaberite uslugu, veličinu i lokaciju. Procjena u sekundi, bez obveze."
    />

    <noscript>
      <p class="calc-noscript">Kalkulator treba JavaScript. Pišite nam na WhatsApp i pošaljemo procjenu ručno.</p>
      <a class="btn btn-wa" href={fallbackWa} target="_blank" rel="noopener" data-wa-source={waSource}>Pišite nam na WhatsApp →</a>
    </noscript>

    <div class="calc-card" data-default-location={defaultLocation}>
      <div class="wizard-progress" role="progressbar" aria-valuemin="1" aria-valuemax="3" aria-valuenow="1" aria-label="Korak 1 od 3">
        <span class="wp-seg active" data-phase="1"><b>1</b> Usluge</span>
        <span class="wp-seg" data-phase="2"><b>2</b> Lokacija</span>
        <span class="wp-seg" data-phase="3"><b>3</b> Ponuda</span>
      </div>

      <div class="calc-screen" data-screen="service">
        <p class="calc-q">Što želite očistiti?</p>
        <div class="calc-services" id="calc-services">
          {SERVICES.map((s) => (
            <button type="button" class="svc-pick" data-service={s.id} data-addon={s.addonOnly ? '1' : '0'}>
              <span class="svc-pick-emoji" aria-hidden="true">{SERVICE_EMOJI[s.id]}</span>
              <span class="svc-pick-name">{s.name}</span>
              <span class="svc-pick-from mono">{s.pickerPrice}</span>
              {s.addonOnly && <span class="svc-pick-note">samo uz drugu</span>}
            </button>
          ))}
        </div>
        <p class="calc-package-hint">
          <strong>Paket Dnevni boravak — {LIVING_ROOM_PACKAGE.price} €</strong>
          {LIVING_ROOM_PACKAGE.includes}.
        </p>
        <div class="calc-actions">
          <button type="button" class="wizard-back" data-act="to-cart" hidden>← Natrag na popis</button>
        </div>
      </div>

      <div class="calc-screen" data-screen="size" hidden>
        <p class="calc-q" id="size-q">Veličina</p>
        <div class="csize-opts" id="size-opts" role="radiogroup" aria-labelledby="size-q"></div>
        <div class="calc-actions">
          <button type="button" class="wizard-back" data-act="size-back">← Natrag</button>
          <button type="button" class="btn btn-cta wizard-next" id="size-add" disabled>Dodaj uslugu →</button>
        </div>
      </div>

      <div class="calc-screen" data-screen="cart" hidden>
        <p class="calc-q">Vaše usluge</p>
        <div class="calc-cart" id="calc-cart"></div>
        <p class="calc-cart-warn" id="cart-warn" hidden></p>
        <div class="calc-actions">
          <button type="button" class="calc-add-more" id="add-more">+ Dodaj još uslugu</button>
          <button type="button" class="btn btn-cta wizard-next" id="to-location">Nastavi → Lokacija</button>
        </div>
      </div>

      <div class="calc-screen" data-screen="location" hidden>
        <p class="calc-q">📍 Lokacija <span class="muted">(neobavezno)</span></p>
        <p class="calc-hint">Unesite mjesto i odmah vidite dolazak.</p>
        <div class="calc-address-row">
          <input type="text" id="calc-address" class="calc-address-input" placeholder="npr. Bjelovar" aria-label="Mjesto ili adresa za izračun dolaska" autocomplete="off" />
          <button type="button" id="calc-search" class="calc-search-btn">Provjeri</button>
        </div>
        <p class="calc-distance" id="calc-distance" aria-live="polite"></p>
        <div class="calc-actions">
          <button type="button" class="wizard-back" data-act="loc-back">← Natrag</button>
          <button type="button" class="btn btn-cta wizard-next" id="to-result">Vidi ponudu →</button>
        </div>
      </div>

      <div class="calc-screen" data-screen="result" hidden>
        <div class="calc-result" aria-live="polite" aria-atomic="true">
          <div class="cr-items" id="cr-items"></div>
          <div class="cr-total-label">Procijenjena cijena</div>
          <div class="cr-total" id="cr-total">0 €</div>
          <p class="cr-note" id="cr-note"></p>
          <a class="btn btn-wa cr-cta" id="cr-wa" href={fallbackWa} target="_blank" rel="noopener" data-wa-source={waSource} aria-label="Zatražite točnu ponudu na WhatsApp">Zatražite točnu ponudu na WhatsApp →</a>
          <p class="cr-disclaim mono">Procjena je orijentacijska. Točnu cijenu potvrđujemo pri dogovoru.</p>
          <div class="calc-actions calc-actions--center">
            <button type="button" class="wizard-back" data-act="res-back">← Promijeni usluge</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { computeQuote, buildWhatsAppPayload, distanceFromBase, hasStandaloneService, resolveTravel } from '../../lib/calculator';
  import type { QuoteItem, TravelQuote } from '../../lib/calculator';
  import { SERVICES, SERVICE_EMOJI } from '../../data/services';
  import { FREE_KM, MIN_ORDER } from '../../data/pricing';

  const MIN_COPY = `Minimalni izlazak je ${MIN_ORDER} €. Dodajte još jednu uslugu ili nas pitajte — možda smo ionako u vašem mjestu tog dana.`;
  const ADDON_COPY = 'Stolica i tabure idu samo uz drugu uslugu. Dodajte kauč, tepih, madrac ili auto.';

  const root = document.querySelector('.calc-card');
  if (root) {
    type Screen = 'service' | 'size' | 'cart' | 'location' | 'result';
    const PHASE: Record<Screen, number> = { service: 1, size: 1, cart: 1, location: 2, result: 3 };

    const cart: QuoteItem[] = [];
    let pending: { id: string; name: string; sizeLabel: string; price: number } | null = null;
    let locationLabel = (root as HTMLElement).dataset.defaultLocation || '';
    let travel: TravelQuote = resolveTravel(locationLabel);

    const segs = root.querySelectorAll<HTMLElement>('.wp-seg');
    const progress = root.querySelector('.wizard-progress')!;
    const screens = root.querySelectorAll<HTMLElement>('.calc-screen');
    const scr = (s: Screen) => root.querySelector<HTMLElement>(`.calc-screen[data-screen="${s}"]`)!;

    function show(s: Screen, scroll = true) {
      screens.forEach((el) => { el.hidden = el.dataset.screen !== s; });
      const ph = PHASE[s];
      segs.forEach((seg) => seg.classList.toggle('active', Number(seg.dataset.phase) <= ph));
      progress.setAttribute('aria-valuenow', String(ph));
      progress.setAttribute('aria-label', `Korak ${ph} od 3`);
      if (s === 'service') markServices();
      if (s === 'cart') renderCart();
      if (s === 'result') renderResult();
      if (scroll) scrollToCard();
    }

    const svcBack = scr('service').querySelector<HTMLButtonElement>('[data-act="to-cart"]')!;
    function markServices() {
      root!.querySelectorAll<HTMLButtonElement>('.svc-pick').forEach((btn) => {
        const added = cart.some((it) => it.id === btn.dataset.service);
        btn.classList.toggle('is-added', added);
        btn.disabled = added;
      });
      svcBack.hidden = cart.length === 0;
    }
    root.querySelectorAll<HTMLButtonElement>('.svc-pick').forEach((btn) => {
      btn.addEventListener('click', () => {
        const service = SERVICES.find((s) => s.id === btn.dataset.service);
        if (!service) return;
        buildSize(service);
        show('size');
      });
    });
    svcBack.addEventListener('click', () => show('cart'));

    const sizeQ = root.querySelector('#size-q')!;
    const sizeOpts = root.querySelector('#size-opts')!;
    const sizeAdd = root.querySelector('#size-add') as HTMLButtonElement;
    function buildSize(service: typeof SERVICES[number]) {
      pending = { id: service.id, name: service.name, sizeLabel: '', price: 0 };
      sizeQ.textContent = service.sizeLabel;
      sizeOpts.innerHTML = service.sizes
        .map(
          (o) => `<label class="csize-pill"><input type="radio" name="size-pick" value="${o.id}" data-price="${o.price}" data-label="${o.label}"><span>${o.label}</span><b class="mono">${o.price} €</b></label>`,
        )
        .join('');
      sizeOpts.querySelectorAll<HTMLInputElement>('input').forEach((r) => {
        r.addEventListener('change', () => {
          if (!pending) return;
          pending.sizeLabel = r.dataset.label || '';
          pending.price = Number(r.dataset.price);
          sizeAdd.disabled = false;
        });
      });
      if (service.sizes.length === 1) {
        const only = service.sizes[0]!;
        pending.sizeLabel = only.label;
        pending.price = only.price;
        sizeOpts.querySelector<HTMLInputElement>('input')!.checked = true;
        sizeAdd.disabled = false;
      } else {
        sizeAdd.disabled = true;
      }
    }
    sizeAdd.addEventListener('click', () => {
      if (!pending || !pending.sizeLabel) return;
      cart.push({ ...pending });
      pending = null;
      show('cart');
    });
    scr('size').querySelector('[data-act="size-back"]')!.addEventListener('click', () => {
      pending = null;
      show(cart.length ? 'cart' : 'service');
    });

    const cartEl = root.querySelector('#calc-cart')!;
    const cartWarn = root.querySelector('#cart-warn') as HTMLElement;
    const toLocation = root.querySelector('#to-location') as HTMLButtonElement;
    function renderCart() {
      cartEl.innerHTML = cart
        .map(
          (it, i) => `<div class="cart-row"><span class="cart-name">${SERVICE_EMOJI[it.id as keyof typeof SERVICE_EMOJI]} ${it.name} <span class="cart-size">${it.sizeLabel}</span></span><span class="cart-price mono">${it.price} €</span><button type="button" class="cart-del" data-i="${i}" aria-label="Ukloni ${it.name}">✕</button></div>`,
        )
        .join('');
      const standalone = hasStandaloneService(cart);
      const q = computeQuote(cart, travel);
      if (!standalone) {
        cartWarn.hidden = false;
        cartWarn.textContent = ADDON_COPY;
        toLocation.disabled = true;
      } else if (q.subtotal < MIN_ORDER) {
        cartWarn.hidden = false;
        cartWarn.textContent = MIN_COPY;
        toLocation.disabled = false;
      } else {
        cartWarn.hidden = true;
        toLocation.disabled = false;
      }
      cartEl.querySelectorAll<HTMLButtonElement>('.cart-del').forEach((b) => {
        b.addEventListener('click', () => {
          cart.splice(Number(b.dataset.i), 1);
          if (cart.length === 0) show('service');
          else renderCart();
        });
      });
    }
    root.querySelector('#add-more')!.addEventListener('click', () => show('service'));
    toLocation.addEventListener('click', () => {
      if (!hasStandaloneService(cart)) return;
      show('location');
    });

    scr('location').querySelector('[data-act="loc-back"]')!.addEventListener('click', () => show('cart'));
    root.querySelector('#to-result')!.addEventListener('click', () => show('result'));

    function renderResult() {
      const q = computeQuote(cart, travel);
      const itemsEl = root!.querySelector('#cr-items')!;
      const rows = cart.map(
        (i) => `<div class="cr-row"><span>${i.sizeLabel}</span><span class="mono">${i.price} €</span></div>`,
      );
      if (q.travel > 0) rows.push(`<div class="cr-row"><span>Dolazak</span><span class="mono">+${q.travel} €</span></div>`);
      if (q.minApplied) rows.push(`<div class="cr-row cr-disc"><span>Dopuna do minimuma</span><span class="mono">+${q.total - q.subtotal - q.travel} €</span></div>`);
      itemsEl.innerHTML = rows.join('');
      (root!.querySelector('#cr-total') as HTMLElement).textContent = `${q.total} €`;
      const note = root!.querySelector('#cr-note') as HTMLElement;
      const parts: string[] = [];
      if (q.minApplied) parts.push(MIN_COPY);
      if (q.travelNote) parts.push(q.travelNote);
      note.textContent = parts.join(' ');
      (root!.querySelector('#cr-wa') as HTMLAnchorElement).href = buildWhatsAppPayload(q, locationLabel || undefined);
      const plausible = (window as unknown as { plausible?: (n: string, o?: object) => void }).plausible;
      plausible?.('kalkulator_zavrsen', { props: { iznos: q.total } });
    }
    scr('result').querySelector('[data-act="res-back"]')!.addEventListener('click', () => show('cart'));

    function scrollToCard() {
      const top = (root as HTMLElement).getBoundingClientRect().top + window.scrollY - 80;
      window.scrollTo({ top, behavior: 'smooth' });
    }

    const searchBtn = root.querySelector('#calc-search') as HTMLButtonElement;
    const addressInput = root.querySelector('#calc-address') as HTMLInputElement;
    const distanceEl = root.querySelector('#calc-distance') as HTMLElement;
    if (locationLabel) addressInput.value = locationLabel;

    async function search() {
      const q = addressInput.value.trim();
      if (!q) return;
      searchBtn.disabled = true;
      searchBtn.textContent = 'Tražim…';
      distanceEl.textContent = '';
      try {
        locationLabel = q;
        travel = resolveTravel(q);
        const url = 'https://nominatim.openstreetmap.org/search?format=json&limit=1&countrycodes=hr&q=' + encodeURIComponent(q);
        const res = await fetch(url, { headers: { Accept: 'application/json' } });
        const data = (await res.json()) as Array<{ lat: string; lon: string; display_name: string }>;
        if (!data.length) {
          distanceEl.textContent = travel.known
            ? travel.note
            : 'Nismo našli to mjesto. Pokušajte drugačije ili nas pitajte na WhatsApp.';
          return;
        }
        const named = resolveTravel(`${q} ${data[0].display_name}`);
        if (named.known) travel = named;
        const km = Math.round(distanceFromBase(parseFloat(data[0].lat), parseFloat(data[0].lon)));
        if (travel.known) {
          distanceEl.textContent = `~${km} km od Vrbovca. ${travel.note}`;
        } else if (km <= FREE_KM) {
          travel = { fee: 0, minOrder: MIN_ORDER, note: 'Besplatan dolazak.', known: true };
          distanceEl.textContent = `~${km} km od Vrbovca, besplatan dolazak ✓`;
        } else {
          distanceEl.textContent = `~${km} km od Vrbovca. Putni trošak potvrđujemo pri dogovoru.`;
        }
      } catch {
        distanceEl.textContent = 'Trenutno ne možemo provjeriti udaljenost. Slobodno nastavite, dogovaramo na WhatsApp.';
      } finally {
        searchBtn.disabled = false;
        searchBtn.textContent = 'Provjeri';
      }
    }
    searchBtn.addEventListener('click', search);
    addressInput.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); search(); } });

    show('service', false);
  }
</script>
