---
import SectionHeader from '../primitives/SectionHeader.astro';
import Button from '../primitives/Button.astro';
import ShaderBg from './ShaderBg.astro';
import galerija from '../../data/galerija.json';

interface Props {
  defaultUsluga?: string;
}
const { defaultUsluga } = Astro.props;
const pairs = galerija;
const usluge = [...new Set(pairs.map((p) => p.usluga))];
const initial = pairs.find((p) => p.usluga === defaultUsluga) ?? pairs[0]!;
---
<section class="section section-dark" id="dokaz">
  <ShaderBg id="dokaz-shader" amp={220} seed={11} freqX={0.0002} freqY={0.00018} />
  <div class="container ba-wrap">
    <div class="ba-copy">
      <SectionHeader
        onDark
        align="left"
        eyebrow="Vizualni dokaz"
        title={`Razlika koja se<br><span class="accent">vidi golim okom.</span>`}
        sub="Nije reklama, ovo su naši pravi rezultati. Povucite klizač i usporedite."
      />
      <div class="ba-tabs" role="tablist" aria-label="Odaberi kategoriju">
        {usluge.map((u) => (
          <button
            class:list={['ba-tab', u === initial.usluga && 'active']}
            role="tab"
            aria-selected={u === initial.usluga ? 'true' : 'false'}
            data-pair={u}
          >{u.charAt(0).toUpperCase() + u.slice(1)}</button>
        ))}
      </div>
      <ul class="ba-points" role="list">
        <li><span class="ba-check" aria-hidden="true"></span><span><strong>Eko sredstva</strong> — sigurno za djecu i ljubimce</span></li>
        <li><span class="ba-check" aria-hidden="true"></span><span><strong>Suši se za 2–4 h</strong> — isti dan u funkciji</span></li>
        <li><span class="ba-check" aria-hidden="true"></span><span><strong>Garancija povrata novca</strong> ako niste zadovoljni</span></li>
      </ul>
      <Button href="#cjenik" variant="cta" class="ba-cta">Pogledajte cjenik →</Button>
    </div>

    <figure class="ba-widget">
      <div class="proof-split big" id="ba-split">
        <img id="ba-after-img" src={initial.after} alt={`Slika nakon čišćenja, ${initial.label}`} class="proof-after" width={initial.width} height={initial.height} loading="lazy" decoding="async" />
        <img id="ba-before-img" src={initial.before} alt={`Slika prije čišćenja, ${initial.label}`} class="proof-before" width={initial.width} height={initial.height} loading="lazy" decoding="async" style="clip-path:inset(0 50% 0 0)" />
        <span class="proof-divider" id="ba-divider" style="left:50%"></span>
        <button
          class="ba-handle"
          id="ba-handle"
          role="slider"
          aria-label="Klizač za usporedbu prije i poslije"
          aria-valuemin="0"
          aria-valuemax="100"
          aria-valuenow="50"
          aria-valuetext="50% prikaza nakon čišćenja"
          tabindex="0"
          style="left:50%"
        ></button>
        <span class="proof-tag proof-tag-before">PRIJE</span>
        <span class="proof-tag proof-tag-after">NAKON</span>
      </div>
    </figure>
  </div>
</section>

<script>
  import galerija from '../../data/galerija.json';

  const PAIRS = Object.fromEntries(galerija.map((p) => [p.usluga, p]));

  const split = document.getElementById('ba-split')!;
  const divider = document.getElementById('ba-divider')!;
  const handle = document.getElementById('ba-handle')!;
  const beforeImg = document.getElementById('ba-before-img') as HTMLImageElement;
  const afterImg = document.getElementById('ba-after-img') as HTMLImageElement;
  let value = 50;
  let rect: DOMRect | null = null;
  let rafId = 0;

  function paint() {
    rafId = 0;
    beforeImg.style.clipPath = `inset(0 ${100 - value}% 0 0)`;
    divider.style.left = value + '%';
    handle.style.left = value + '%';
  }

  function setValue(v: number) {
    value = Math.max(0, Math.min(100, Math.round(v)));
    handle.setAttribute('aria-valuenow', String(value));
    handle.setAttribute('aria-valuetext', `${value}% prikaza nakon čišćenja`);
    if (!rafId) rafId = requestAnimationFrame(paint);
  }

  function fromClientX(clientX: number) {
    const r = rect ?? (rect = split.getBoundingClientRect());
    setValue(((clientX - r.left) / r.width) * 100);
  }

  let dragging = false;
  split.addEventListener('pointerdown', (e) => {
    dragging = true;
    rect = split.getBoundingClientRect();
    try { split.setPointerCapture(e.pointerId); } catch {}
    handle.focus({ preventScroll: true });
    fromClientX(e.clientX);
    e.preventDefault();
  });
  split.addEventListener('pointermove', (e) => { if (dragging) fromClientX(e.clientX); });
  const stop = (e: PointerEvent) => {
    dragging = false;
    rect = null;
    try { split.releasePointerCapture(e.pointerId); } catch {}
  };
  split.addEventListener('pointerup', stop);
  split.addEventListener('pointercancel', stop);

  handle.addEventListener('keydown', (e) => {
    const step = e.shiftKey ? 10 : 2;
    if (e.key === 'ArrowLeft' || e.key === 'ArrowDown') { e.preventDefault(); setValue(value - step); }
    else if (e.key === 'ArrowRight' || e.key === 'ArrowUp') { e.preventDefault(); setValue(value + step); }
    else if (e.key === 'Home') { e.preventDefault(); setValue(0); }
    else if (e.key === 'End') { e.preventDefault(); setValue(100); }
  });

  document.querySelectorAll<HTMLButtonElement>('.ba-tab').forEach((tab) => {
    tab.addEventListener('click', () => {
      const key = tab.dataset.pair as string;
      const pair = PAIRS[key];
      if (!pair) return;
      document.querySelectorAll('.ba-tab').forEach((t) => {
        t.classList.toggle('active', t === tab);
        t.setAttribute('aria-selected', String(t === tab));
      });
      beforeImg.src = pair.before;
      beforeImg.alt = `Slika prije čišćenja, ${pair.label}`;
      afterImg.src = pair.after;
      afterImg.alt = `Slika nakon čišćenja, ${pair.label}`;
      setValue(50);
    });
  });
</script>
