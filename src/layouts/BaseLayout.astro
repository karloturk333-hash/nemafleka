---
// Only the latin + latin-ext subsets are imported — Croatian needs latin-ext (č ć š ž đ)
// but never cyrillic/greek/vietnamese, whose @font-face blocks would otherwise be inlined
// into every page's HTML (inlineStylesheets: 'always').
import '@fontsource/space-grotesk/latin-600.css';
import '@fontsource/space-grotesk/latin-ext-600.css';
import '@fontsource/space-grotesk/latin-700.css';
import '@fontsource/space-grotesk/latin-ext-700.css';
import '@fontsource/manrope/latin-400.css';
import '@fontsource/manrope/latin-ext-400.css';
import '@fontsource/manrope/latin-600.css';
import '@fontsource/manrope/latin-ext-600.css';
import '@fontsource/manrope/latin-700.css';
import '@fontsource/manrope/latin-ext-700.css';
import '@fontsource/space-mono/latin-400.css';
import '@fontsource/space-mono/latin-ext-400.css';
import '@fontsource/space-mono/latin-700.css';
import '@fontsource/space-mono/latin-ext-700.css';
import groteskDisplay from '@fontsource/space-grotesk/files/space-grotesk-latin-700-normal.woff2?url';
import manropeBody from '@fontsource/manrope/files/manrope-latin-400-normal.woff2?url';
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/components.css';

import Nav from '../components/sections/Nav.astro';
import Footer from '../components/sections/Footer.astro';
import WhatsAppFloat from '../components/sections/WhatsAppFloat.astro';
import { BUSINESS } from '../data/business';
import { WA_MSG } from '../lib/links';

interface Props {
  title: string;
  description: string;
  path?: string;
  ogImage?: string;
  preloadHero?: { src: string; srcset?: string; sizes?: string };
  jsonLd?: unknown[];
  waMessage?: string;
  waSource?: string;
}
const {
  title,
  description,
  path = '/',
  ogImage = BUSINESS.ogImage,
  preloadHero,
  jsonLd = [],
  waMessage = WA_MSG.sticky,
  waSource = 'sticky',
} = Astro.props;

const canonical = path === '/' ? BUSINESS.url : new URL(path, BUSINESS.url).href;
const ogImageUrl = new URL(ogImage, BUSINESS.url).href;
const plausibleDomain =
  (import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN as string | undefined) ||
  (import.meta.env.PROD ? 'nemafleka.com' : '');
const gsc = import.meta.env.PUBLIC_GSC_VERIFICATION as string | undefined;
---
<!doctype html>
<html lang="hr" dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="hr_HR" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content={String(BUSINESS.ogImageWidth)} />
    <meta property="og:image:height" content={String(BUSINESS.ogImageHeight)} />
    <meta property="og:image:alt" content="Nema Fleka — dubinsko čišćenje kauča, tepiha, madraca i automobila" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content="Nema Fleka — dubinsko čišćenje kauča, tepiha, madraca i automobila" />
    {gsc && <meta name="google-site-verification" content={gsc} />}

    <link rel="icon" type="image/x-icon" href="/images/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/images/favicon-192.png" />
    <link rel="apple-touch-icon" href="/images/apple-touch-icon.png" />

    <link rel="preload" as="font" type="font/woff2" href={groteskDisplay} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={manropeBody} crossorigin />

    {preloadHero && (
      <link
        rel="preload"
        as="image"
        href={preloadHero.src}
        imagesrcset={preloadHero.srcset}
        imagesizes={preloadHero.sizes}
        fetchpriority="high"
      />
    )}

    {jsonLd.map((obj) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(obj)} />
    ))}

    {plausibleDomain && (
      <script is:inline defer data-domain={plausibleDomain} src="https://plausible.io/js/script.tagged-events.js"></script>
    )}
  </head>
  <body>
    <a href="#main-content" class="skip-link">Preskoči na sadržaj</a>
    <Nav waMessage={waMessage} waSource={waSource} />
    <main id="main-content">
      <slot />
    </main>
    <Footer waMessage={waMessage} waSource={waSource} />
    <WhatsAppFloat waMessage={waMessage} waSource={waSource} />
    <script is:inline>
      document.addEventListener('click', function (e) {
        var a = e.target && e.target.closest ? e.target.closest('a[data-wa-source], a[href*="wa.me"]') : null;
        if (!a || typeof window.plausible !== 'function') return;
        var izvor = a.getAttribute('data-wa-source') || 'ostalo';
        window.plausible('whatsapp_klik', { props: { izvor: izvor } });
      });
    </script>
  </body>
</html>
