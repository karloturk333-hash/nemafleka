# Public env (Astro inlines PUBLIC_* at build time).
# Plausible: create the site at plausible.io then this domain records events.
PUBLIC_PLAUSIBLE_DOMAIN=nemafleka.com

# Google Search Console HTML-tag verification (optional).
# PUBLIC_GSC_VERIFICATION=

# Google Business Profile URL — shown in footer + under reviews when set.
# PUBLIC_GOOGLE_BUSINESS_URL=
