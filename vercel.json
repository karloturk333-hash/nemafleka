{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/nemafleka-v5.html", "destination": "/", "permanent": true },
    { "source": "/dubinsko-ciscenje-dugo-selo", "destination": "/podrucje-pokrivenosti", "permanent": true },
    { "source": "/dubinsko-ciscenje-dugo-selo.html", "destination": "/podrucje-pokrivenosti", "permanent": true },
    { "source": "/dubinsko-ciscenje-ivanic-grad", "destination": "/podrucje-pokrivenosti", "permanent": true },
    { "source": "/dubinsko-ciscenje-ivanic-grad.html", "destination": "/podrucje-pokrivenosti", "permanent": true },
    { "source": "/dubinsko-ciscenje-krizevci", "destination": "/podrucje-pokrivenosti", "permanent": true },
    { "source": "/dubinsko-ciscenje-krizevci.html", "destination": "/podrucje-pokrivenosti", "permanent": true },
    { "source": "/dubinsko-ciscenje-bjelovar", "destination": "/podrucje-pokrivenosti", "permanent": true },
    { "source": "/dubinsko-ciscenje-bjelovar.html", "destination": "/podrucje-pokrivenosti", "permanent": true },
    { "source": "/dubinsko-ciscenje-koprivnica", "destination": "/podrucje-pokrivenosti", "permanent": true },
    { "source": "/dubinsko-ciscenje-koprivnica.html", "destination": "/podrucje-pokrivenosti", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/images/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
